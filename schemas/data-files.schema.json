{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zape.local/schemas/data-files.schema.json",
  "title": "Zape persisted data sidecar manifest",
  "type": "object",
  "required": ["manifestVersion", "tenantId", "generatedAt", "files"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "tenantId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["schemaVersion", "sha256", "bytes"],
        "properties": {
          "schemaVersion": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
