# Zape - exemplo de configuração
# Copie para .env e substitua apenas por valores do ambiente.
# Nunca use dados reais em desenvolvimento ou testes.

# Runtime
NODE_ENV=development
# Em produção, mantenha o Node privado em loopback e exponha somente o Nginx.
HOST=127.0.0.1
PORT=3000
# Número explícito de proxies confiáveis. Use 1 com o Nginx desta fase. Nunca use true.
TRUST_PROXY_HOPS=0
DEBUG=0
DEBUG_AUTH=0
AUDIO_DEBUG=0
PUBLIC_BASE_URL=http://127.0.0.1:3000
# Produção: https://seu-dominio.com.br
# APP_BASE_URL=  # alias legado de PUBLIC_BASE_URL

# Origens extras autorizadas a operar o painel no navegador.
# Same-origin não precisa ser listado. Nunca use *.
APP_ALLOWED_ORIGINS=
# CORS_ALLOWED_ORIGINS=  # alias legado; não configure listas divergentes


# Infraestrutura de produção
# O boot de produção recusa execução como root por padrão.
INFRA_ALLOW_ROOT_PROCESS=0
# Somente testes locais controlados podem liberar PUBLIC_BASE_URL HTTP em NODE_ENV=production.
INFRA_ALLOW_HTTP_FOR_TESTS=0
# Diretórios recomendados fora da pasta de release.
ZAPE_DATA_DIR=/var/lib/zape/data
ZAPE_LOG_DIR=/var/log/zape
ZAPE_BACKUP_DIR=/var/backups/zape
ZAPE_APP_DIR=/opt/zape/current
ZAPE_MAX_MEMORY=1G

# Sessão e autenticação
# Gere uma string independente com pelo menos 32 bytes aleatórios.
# Exemplo de geração: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-cryptographically-random-value
# Arquivo persistente com hashes das sessões. Nunca versione esse arquivo.
# SESSION_STORE_FILE=/var/lib/zape/auth_sessions.json

# Limites de login. O processo atual usa uma instância PM2.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_BLOCK_MS=900000
AUTH_RATE_LIMIT_IP_MAX_ATTEMPTS=12
AUTH_RATE_LIMIT_TENANT_IP_MAX_ATTEMPTS=6
AUTH_RATE_LIMIT_TENANT_MAX_ATTEMPTS=120
# Em produção atrás do Nginx da Fase 13, use 1. O IP será lido de req.ip após trust proxy numérico.
AUTH_TRUST_PROXY_HEADERS=0

# Tenants de teste. Habilite apenas os painéis realmente utilizados.
ADMIN_ENABLED=1
ADMIN_USER=admin
ADMIN_PASS=lC9L3hostapi
# compat (alguns setups antigos usam ADMIN_KEY)
ADMIN_KEY=lC9L3hostapi
ADMIN_ROLE=super_admin
PANEL_ENABLED=1
PANEL_USER=panel
PANEL_PASS=lC9L3hostapi312
PANEL_ROLE=tenant_admin
REGINA_ENABLED=1
REGINA_USER=regina
REGINA_PASS=RegInahostapi331
REGINA_ROLE=tenant_admin
PORTUGAL_ENABLED=1
PORTUGAL_PASS=portugalcasaads123
PORTUGAL_USER=Portugal
PORTUGAL_ROLE=tenant_admin
FELIPE_ENABLED=1
FELIPE_USER=felipe 
FELIPE_PASS=felipecasadoads321
FELIPE_ROLE=tenant_admin
ANA_ENABLED=1
ANA_USER="ana salomão"
ANA_PASS="anasalomaocao123"
ANA_ROLE=tenant_admin


# Auditoria mínima de ações administrativas
# SECURITY_AUDIT_FILE=/var/log/zape/security_audit.jsonl


# Segurança dos endpoints públicos e webhooks
# Em produção, o formulário legado fica desabilitado por padrão.
PUBLIC_LEAD_FORM_ENABLED=0
PUBLIC_LEAD_FORM_TOKEN=replace-with-a-strong-random-form-token

# Webhook fixo ActiveCampaign. Habilite explicitamente e use token com 32+ caracteres.
ACTIVECAMPAIGN_WEBHOOK_ENABLED=0
ACTIVECAMPAIGN_WEBHOOK_TOKEN=replace-with-a-strong-random-activecampaign-token

# Webhooks customizados usam HMAC SHA-256 com timestamp e event ID.
# Em produção esta proteção é obrigatória mesmo que a variável seja 0.
CUSTOM_WEBHOOK_REQUIRE_SIGNATURE=1
CUSTOM_WEBHOOK_CLOCK_TOLERANCE_SECONDS=300

# Tokens via query string ficam desativados porque podem aparecer em logs e histórico.
# Prefira X-Zape-Webhook-Token ou Authorization: Bearer.
ALLOW_WEBHOOK_TOKEN_IN_QUERY=0

# Em produção atrás do Nginx da Fase 13, use 1.
PUBLIC_ENDPOINT_TRUST_PROXY_HEADERS=0

# Limites específicos dos endpoints públicos
PUBLIC_FORM_BODY_LIMIT=250kb
PUBLIC_WEBHOOK_BODY_LIMIT=500kb
META_WEBHOOK_BODY_LIMIT=1mb
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_FORM_RATE_LIMIT_MAX=20
ACTIVECAMPAIGN_RATE_LIMIT_MAX=120
CUSTOM_WEBHOOK_RATE_LIMIT_MAX=120
META_WEBHOOK_RATE_LIMIT_MAX=600

# Idempotência persistente. Mantenha fora da pasta de deploy quando possível.
# WEBHOOK_IDEMPOTENCY_FILE=/var/lib/zape/webhook_idempotency.json
WEBHOOK_IDEMPOTENCY_RETENTION_MS=604800000
WEBHOOK_IDEMPOTENCY_PENDING_TIMEOUT_MS=900000

# Diagnóstico legado. Nunca habilitar em produção.
ENABLE_DEBUG_ACTIVE=0

# WhatsApp Web
WEBJS_ENABLED=0
WEBJS_AUTO_START=0
WEBJS_AUTO_START_TENANTS=
WEBJS_HEADLESS=1
WEBJS_NO_SANDBOX=0
WEBJS_WEB_VERSION=
WEBJS_REMOTE_CACHE=0
WEBJS_REMOTE_PATH=
WEBJS_REMOTE_STRICT=0
WEBJS_DEFAULT_TEMPLATE_TEXT=Mensagem de teste
# WEBJS_SESSION=lead-bot  # usado apenas pelo módulo legado src/whatsapp.js
CHROME_EXECUTABLE_PATH=
FFMPEG_PATH=
WA_READY_TIMEOUT_MS=60000
WA_AUTH_WATCHDOG_MS=60000
WA_AUTH_WATCHDOG_INTERVAL_MS=2000

# CRM externo
CRM_INTEGRATION_ENABLED=0
CRM_INTEGRATION_URL=https://crm.example.invalid
CRM_INTEGRATION_KEY=fake-test-key-not-valid
CRM_INTEGRATION_TIMEOUT_MS=15000
CRM_INTEGRATION_MAX_ATTEMPTS=6
CRM_INTEGRATION_WORKER_INTERVAL_MS=30000
# EXTERNAL_CRM_QUEUE_FILE=  # deixe vazio para usar data/external_crm_queue.json
CRM_INTEGRATION_ACTIVE_CAMPAIGN_TO_CRM_ENABLED=0
CRM_INTEGRATION_ACTIVE_CAMPAIGN_PIPELINE_ID=
CRM_INTEGRATION_ACTIVE_CAMPAIGN_STAGE_ID=
CRM_INTEGRATION_ACTIVE_CAMPAIGN_SOURCE=WhatsApp

# WhatsApp Cloud API / Meta
WA_CLOUD_ENABLED=0
WA_CLOUD_GRAPH_VERSION=v25.0
WA_CLOUD_FORCE_ENV=1
WA_CLOUD_TOKEN=fake-test-token-not-valid
WA_CLOUD_PHONE_NUMBER_ID=000000000000000
WA_CLOUD_WABA_ID=000000000000000
WA_CLOUD_WEBHOOK_VERIFY_TOKEN=fake-test-verify-token
WA_CLOUD_CONNECTION_OWNER_TENANT=admin
# Somente testes/homologação local. Ignorado em NODE_ENV=production.
# WA_CLOUD_GRAPH_BASE_URL=http://127.0.0.1:9000


# Fila persistente da WhatsApp Cloud API - Fase 10
# Uma única instância/worker enquanto a fila usar arquivo local.
WA_CLOUD_QUEUE_POLL_MS=250
WA_CLOUD_QUEUE_MAX_ATTEMPTS=5
WA_CLOUD_QUEUE_RETRY_BASE_MS=1000
WA_CLOUD_QUEUE_RETRY_MAX_MS=60000
WA_CLOUD_CAMPAIGN_MAX_CONTACTS=10000

# Embedded Signup
WA_EMBEDDED_APP_ID=000000000000000
WA_EMBEDDED_APP_SECRET=fake-test-app-secret-not-valid
WA_EMBEDDED_CONFIG_ID=000000000000000
WA_EMBEDDED_REDIRECT_URI=http://127.0.0.1:3000/admin

# Aliases legados aceitos pelo código atual, não configure junto com as variáveis acima:
# META_WA_ACCESS_TOKEN=
# META_WA_PHONE_NUMBER_ID=
# META_WA_WABA_ID=
# META_WA_FORCE_ENV=
# META_GRAPH_VERSION=
# META_APP_ID=
# META_APP_SECRET=
# META_LOGIN_CONFIG_ID=
# META_REDIRECT_URI=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_LOGIN_CONFIG_ID=
# FACEBOOK_REDIRECT_URI=

# Cofre local de segredos persistentes
# Obrigatório para salvar App Secret, token da Cloud API e tokens de webhooks no disco.
# Gere uma chave por ambiente e guarde fora do Git:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONFIG_ENCRYPTION_KEY=replace-with-32-byte-base64-test-key

# Compatibilidade emergencial com JSON legado em texto puro.
# Mantenha 0. Use somente durante janela controlada de migração e remova depois.
ALLOW_LEGACY_PLAINTEXT_SECRETS=0

# Opcional para testes e migrações em cópias isoladas.
# ZAPE_DATA_DIR=/caminho/para/dados-sinteticos

# Segurança de mídias e uploads - Fase 6
# Parser JSON/urlencoded das rotas autenticadas. Uploads de mídia usam streaming separado.
AUTHENTICATED_BODY_LIMIT=16mb
# Limite absoluto da transmissão binária. Limites menores por categoria continuam valendo.
MEDIA_ABSOLUTE_MAX_BYTES=26214400
MEDIA_AUDIO_MAX_BYTES=10485760
MEDIA_IMAGE_MAX_BYTES=12582912
MEDIA_VIDEO_MAX_BYTES=26214400
MEDIA_PDF_MAX_BYTES=20971520
MEDIA_DOCUMENT_MAX_BYTES=20971520
MEDIA_SPREADSHEET_MAX_BYTES=20971520
MEDIA_PRESENTATION_MAX_BYTES=20971520
MEDIA_ARCHIVE_MAX_BYTES=15728640
MEDIA_TEXT_MAX_BYTES=2097152
# Integração opcional com scanner. Use JSON para evitar interpretação por shell.
# Exemplo ClamAV: ["clamdscan","--no-summary"]
MEDIA_SCANNER_COMMAND_JSON=
# Use 1 apenas depois que o scanner estiver instalado e validado no servidor.
MEDIA_SCANNER_REQUIRED=0
MEDIA_SCANNER_TIMEOUT_MS=30000
# Mídias órfãs só entram em quarentena após este prazo. O script é dry-run por padrão.
MEDIA_ORPHAN_RETENTION_DAYS=30

# Integridade de dados e migrações controladas
DATA_INTEGRITY_VALIDATE_ON_BOOT=1
DATA_INTEGRITY_STRICT_BOOT=0
LEADS_INVALID_LINE_QUARANTINE=1
# Os scripts de auditoria/migração exigem --data-dir ou usam ZAPE_DATA_DIR.
# A aplicação da migração exige --apply --confirm=APPLY_DATA_INTEGRITY.
# A quarentena física de mídia exige também --confirm-media=QUARANTINE_ORPHAN_MEDIA.

# Persistência relacional - Fase 11
# json: compatibilidade atual; shadow: comparação temporária; database: banco como fonte principal para leads.
PERSISTENCE_MODE=json
# Produção deve usar PostgreSQL. Exemplo sintético, não copie credenciais reais para o Git:
# DATABASE_URL=postgresql://zape:replace-me@127.0.0.1:5432/zape
DATABASE_SSL=require
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
# Obrigatórios somente em shadow. O prazo expirado bloqueia o boot.
# PERSISTENCE_SHADOW_UNTIL=2026-08-15T23:59:59-03:00
# PERSISTENCE_SHADOW_OWNER=responsavel-tecnico
# SQLite é aceito apenas em testes locais: DATABASE_URL=sqlite:/tmp/zape-test.sqlite

# Fase 12: observabilidade, alertas, retenção, backup e LGPD
LOG_LEVEL=info
STRUCTURED_LOG_FILE=/var/log/zape/application.jsonl
STRUCTURED_LOG_MAX_BYTES=10485760
STRUCTURED_LOG_MAX_FILES=10
SECURITY_AUDIT_FILE=/var/lib/zape/audit/security_audit.jsonl
MONITOR_INTERVAL_MS=300000
ALERT_COOLDOWN_MS=900000
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ALERT_STATE_FILE=/var/lib/zape/monitoring/alerts_state.json
ALERT_DISK_USED_PERCENT=85
ALERT_QUEUE_STALLED_MS=900000
ALERT_BACKUP_MAX_AGE_MS=93600000
BACKUP_DIRECTORY=/var/backups/zape/local
BACKUP_REMOTE_DIRECTORY=/mnt/zape-offsite
BACKUP_ENCRYPTION_KEY=
RETENTION_LOGS_DAYS=30
RETENTION_AUDIT_DAYS=365
RETENTION_EXPORTS_DAYS=7
RETENTION_BACKUPS_DAYS=30
RETENTION_WEBHOOK_EVENTS_DAYS=30
RETENTION_MESSAGE_STATUSES_DAYS=180
RETENTION_CLOUD_EVENTS_DAYS=180
RETENTION_MEDIA_DAYS=365
RETENTION_JOBS_DAYS=30
EXPORT_DIRECTORY=/var/lib/zape/exports

# Fase 15: staging e homologação sintética
# Estas variáveis são geradas por scripts/create-staging-environment.js e não devem ser copiadas para produção.
# STAGING_SYNTHETIC_ONLY=1
# STAGING_ENVIRONMENT_ID=phase15-identificador-aleatorio
# REDIS_URL=redis://127.0.0.1:56379/15

# -----------------------------------------------------------------------------
# Fase 16: identificação de release, rollout gradual e feature flags
# -----------------------------------------------------------------------------
RELEASE_ID=development
RELEASE_COMMIT=
RELEASE_BUILT_AT=
DEPLOYMENT_ENVIRONMENT=development
DEPLOYMENT_ROLLOUT_SEED=zape-development
DEPLOY_HEALTH_URL=https://example.invalid/health
DEPLOY_STATE_FILE=/var/lib/zape/deployment-state.json

# Cada feature aceita também os sufixos _TENANTS e _ROLLOUT_PERCENT.
# Exemplo: FEATURE_FRONTEND_V2_TENANTS=admin,panel
# Exemplo: FEATURE_FRONTEND_V2_ROLLOUT_PERCENT=50
FEATURE_AUTH_V2=1
FEATURE_DATABASE_PERSISTENCE=1
FEATURE_CLOUD_QUEUE=1
FEATURE_SECURE_MEDIA=1
FEATURE_CLOUD_API_V2=1
FEATURE_LEAD_PAGINATION=1
FEATURE_FRONTEND_V2=1
